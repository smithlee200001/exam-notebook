{
  "type": "object",
  "properties": {
    "type": {
      "const": "geometry"
    },
    "version": {
      "const": 1
    },
    "coordinateSystem": {
      "const": "screen"
    },
    "viewBox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "points": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "label": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\u0000]*$"
          },
          "dx": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "dy": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "required": [
          "x",
          "y",
          "label",
          "dx",
          "dy"
        ],
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "dashed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "circles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "center": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "dashed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "center",
          "radius"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "polygons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
            },
            "maxItems": 100,
            "minItems": 3
          },
          "fill": {
            "enum": [
              "none",
              "shade"
            ]
          }
        },
        "required": [
          "points",
          "fill"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "required": [
          "x",
          "y",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "rightAngles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vertex": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
          },
          "arms": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "vertex",
          "arms",
          "size"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "givens": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "length"
              },
              "segment": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "m"
                ]
              }
            },
            "required": [
              "type",
              "segment",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "perpendicular"
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "required": [
              "type",
              "segments"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 100,
      "minItems": 0
    },
    "display": {
      "type": "object",
      "properties": {
        "align": {
          "enum": [
            "left",
            "center"
          ]
        },
        "widthPercent": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "alt": {
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\\u0000]*$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    }
  },
  "required": [
    "type",
    "version",
    "coordinateSystem",
    "viewBox",
    "points",
    "segments",
    "circles",
    "polygons",
    "labels",
    "rightAngles",
    "givens",
    "id",
    "alt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exam notebook geometry block version 1",
  "$id": "https://exam-notebook.local/schemas/geometry.schema.json"
}
