        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^\\u0000]*$"
        },
        "display": {
          "type": "object",
          "properties": {
            "align": {
              "enum": [
                "left",
                "center"
              ]
            }
