{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "target": {
                "enum": [
                  "question",
                  "block"
                ]
              },
              "targetId": {
                "type": "string"
              },
              "type": {
                "const": "choice"
              },
              "explanation": {
                "type": "array",
                "items": {
                  "$ref": "blocks.schema.json#/$defs/block"
                }
              },
              "optionIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "target",
              "type",
              "optionIds"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "block"
                    }
                  }
                },
                "then": {
                  "required": [
                    "targetId"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "targetId"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "enum": [
                  "question",
                  "block"
                ]
              },
              "targetId": {
                "type": "string"
              },
              "type": {
                "const": "fill"
              },
              "explanation": {
                "type": "array",
                "items": {
                  "$ref": "blocks.schema.json#/$defs/block"
                }
              },
              "text": {
                "type": "string",
                "maxLength": 20000,
                "pattern": "^[^\\u0000]*$"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20000,
                  "pattern": "^[^\\u0000]*$"
                }
              }
            },
            "required": [
              "target",
              "type",
              "text"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "block"
                    }
                  }
                },
                "then": {
                  "required": [
                    "targetId"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "targetId"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "enum": [
                  "question",
                  "block"
                ]
              },
              "targetId": {
                "type": "string"
              },
              "type": {
                "const": "solution"
              },
              "explanation": {
                "type": "array",
                "items": {
                  "$ref": "blocks.schema.json#/$defs/block"
                }
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "blocks.schema.json#/$defs/block"
                },
                "minItems": 1
              }
            },
            "required": [
              "target",
              "type",
              "blocks"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "block"
                    }
                  }
                },
                "then": {
                  "required": [
                    "targetId"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "targetId"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://exam-notebook.local/schemas/answer.schema.json"
}
